 "fakta": [
  {
   "typ": "h3",
   "text": "MLADÁ STAVEBNÍ SPOLEČNOST S ODBORNÍKY V OBORU.",
   "zdroj": "https://www.tegma.cz/"
  },
  {
   "typ": "h1",
   "text": "Postavíme vám vaše vysněné bydlení se vším všudy, nebo pouze pomůžeme tam, kde si sami netroufnete.",
   "zdroj": "https://www.tegma.cz/"
  },
  {
   "typ": "h3",
   "text": "Hrubá výstavba",
   "zdroj": "https://www.tegma.cz/"
  },
  {
   "typ": "h3",
   "text": "Suchá výstavba SDK",
   "zdroj": "https://www.tegma.cz/"
  },
  {
   "typ": "h3",
   "text": "izolace proti vodě a zemní vlhkosti",
   "zdroj": "https://www.tegma.cz/"
  },
  {
   "typ": "h2",
   "text": "TEGMA s.r.o.",
   "zdroj": "https://www.tegma.cz/"
  },
  {
   "typ": "h1",
   "text": "Zeptejte se nás, nebo rovnou zavolejte",
   "zdroj": "https://www.tegma.cz/"
  },
  {
   "typ": "odstavec",
   "text": "Nabízíme služby v oblasti stavebnictví především v Jihomoravském kraji, ale neztratíme se ani kdekoliv na území České Republiky.",
   "zdroj": "https://www.tegma.cz/"
  },
  {
   "typ": "odstavec",
   "text": "Zajišťujeme kompletní výstavbu domů od základů až po vybavení interiéru. Nepotřebujete zajistit výstavbu tzv „na klíč“? Nevadí, pomůžeme vám v oblastech, kde si nejste jistí.",
   "zdroj": "https://www.tegma.cz/"
  },
  {
   "typ": "odstavec",
   "text": "Rekonstrukce pro nás není žádný problém. Rozhodli jste se pro novou koupelnu, nebo dětský pokoj? Chcete zajistit rodičům důstojné bydlení? Obraťte se na nás, zajistíme vše od projekce až po kolaudaci, nebo pouze to, na co si netroufáte sami.",
   "zdroj": "https://www.tegma.cz/"
  },
  {
   "typ": "odstavec",
   "text": "Rekonstrukce kanceláře, projekce a výstavba nové provozovny? Se vším vám poradíme a dokážeme zrealizovat od projektu až ke kolaudaci.",
   "zdroj": "https://www.tegma.cz/"
  },
  {
   "typ": "odstavec",
   "text": "Neznáme slovo „nejde“. Děláme maximum pro to, abychom dobře  promítli přání a požadavky zákazníků na výkresy projektové dokumentace. Zastoupíme zákazníka na úřadech a předáme kompletní dokumentaci včetně všech povolení.",
   "zdroj": "https://www.tegma.cz/"
  },
  {
   "typ": "odstavec",
   "text": "Expresní doručení malých zásilek – Do dvou hodin od potvrzení objednávky vyzvedneme u zákazníka a neprodleně doručíme po celé ČR a SR.",
   "zdroj": "https://www.tegma.cz/"
  },
  {
   "typ": "odstavec",
   "text": "Silniční motorová doprava – nákladní provozovaná vozidly nebo jízdními soupravami o největší povolené hmotnosti nepřesahující 3,5 tuny.",
   "zdroj": "https://www.tegma.cz/"
  },
  {
   "typ": "odstavec",
   "text": "Opravy a údržba osobních vozidel – Zajišťujeme drobné opravy a údržbu vozidel, včetně zajištění STK.",
   "zdroj": "https://www.tegma.cz/"
  },
  {
   "typ": "odstavec",
   "text": "Ke každému zákazníkovi se stavíme individuálně, konzultujeme projekt a předem stanovíme ceny.",
   "zdroj": "https://www.tegma.cz/"
  },
  {
   "typ": "odstavec",
   "text": "info@tegma.cz Školská 689/20, 110 00, Praha 1 – Nové Město +420 773 626 411",
   "zdroj": "https://www.tegma.cz/"
  },
